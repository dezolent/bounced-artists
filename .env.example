# Development only. Django reads the process environment; it does not load this file.
DJANGO_SETTINGS_MODULE=config.settings.local
DATABASE_URL=postgresql://bounced_dev:bounced_dev@127.0.0.1:55432/bounced_artists_dev
# Optional for local development. Generate a fresh random secret for production.
DJANGO_SECRET_KEY=

# Required on Railway with config.settings.production:
# DATABASE_URL=${{bounced_artists.DATABASE_URL}}
# DJANGO_SECRET_KEY=<generate-and-store-in-Railway-only>
# DJANGO_ALLOWED_HOSTS=<exact-Railway-hostname>,healthcheck.railway.app
# DJANGO_CSRF_TRUSTED_ORIGINS=https://<exact-Railway-hostname>
# WEB_CONCURRENCY=2
# PORT is assigned by Railway.

# Daily platform sync service: use shared-variable references on Railway.
# OMKAR_API_KEY=
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# ARTIST_SYNC_REQUEST_LIMIT=15000
# ARTIST_SYNC_JOB_REQUEST_LIMIT=1000
# ARTIST_SYNC_JOB_LIMIT=250
# Metadata collection does not require the R2 variables below.

# Optional private media storage in production (all four must be set together).
# Set real values directly in Railway; leave the bucket's public access disabled.
# R2_ACCOUNT_ID=
# R2_BUCKET_NAME=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
